\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sign problem via the toy model: the real part of the integrand $e^{-\phi ^2}\cos (\mu \phi )$ is shown for increasing values of $\mu $. As $\mu $ grows, rapid oscillations make Monte Carlo estimation of the integral exponentially hard.}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:ToySign}{{2}{10}{Sign problem via the toy model: the real part of the integrand $e^{-\phi ^2}\cos (\mu \phi )$ is shown for increasing values of $\mu $. As $\mu $ grows, rapid oscillations make Monte Carlo estimation of the integral exponentially hard}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Overlap vs signal-to-noise problem via the toy model: the phase-quenched weight $e^{-\phi ^2}$ (black solid line) is compared to the full integrand for increasing $\mu $. The two distributions have decreasing overlap, making re-weighting from the phase-quenched ensemble exponentially costly. In contrast, the sign quenched curve(blue solid line) and the full integrand (red dotted line) have good overlap.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:ToySign_Quench}{{3}{10}{Overlap vs signal-to-noise problem via the toy model: the phase-quenched weight $e^{-\phi ^2}$ (black solid line) is compared to the full integrand for increasing $\mu $. The two distributions have decreasing overlap, making re-weighting from the phase-quenched ensemble exponentially costly. In contrast, the sign quenched curve(blue solid line) and the full integrand (red dotted line) have good overlap}{figure.caption.7}{}}
